# Regenerable from the cached download, and large.
/.cache/
/.build/
/build/
/data/tasks.jsonl
/data/smoke_*
/data/selftest_*
/data/agent*
/data/*_validation.jsonl
# one-off --out-prefix runs without the underscore (gate7validation.jsonl, ...);
# the corpus-wide validation.jsonl has no prefix and stays tracked
/data/?*validation.jsonl
/data/difftest_partial.jsonl
# Spot-check output. A subset run (--only, --limit, --solutions-dir) writes here so it can never replace
# the canonical record; see validate.py's and callgraph.py's guards.
/data/partial_*

# Label-audit evidence batches: each embeds a full .dfy and its Python, so the
# payload is 1.4M of content already committed elsewhere. Regenerate with
# `python3 label_audit.py evidence`. The prompt and the verdicts ARE committed --
# they are the inputs and outputs of a judgement, not a copy of the corpus.
/batches/labelaudit/batch_*.json

# Generated snapshots no script reads back (collect.py, summaries).
/out/

# Demo agent runs; the published demo page holds what is shown from them.
/demo/

# Local Python environment: uv venv && uv pip install -r requirements.txt
/.venv/
